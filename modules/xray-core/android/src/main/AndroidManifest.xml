<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <application>
    <service
      android:name=".XrayVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="specialUse">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="VPN connection service" />
    </service>

    <service
      android:name=".CoreVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="specialUse">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="VPN connection service" />
    </service>

    <service
      android:name=".LibCoreVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="specialUse">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="VPN connection service" />
    </service>

    <activity
      android:name=".GhostVpnPermissionActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Автоподключение VPN после загрузки устройства (настройка autoboot) -->
    <receiver
      android:name=".GcBootReceiver"
      android:exported="true"
      android:enabled="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- FileProvider для установки APK-обновлений (самообновление приложения) -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.xrayFileProvider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/xray_file_paths" />
    </provider>
  </application>
</manifest>
